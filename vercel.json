{
  "version": 2,
  "builds": [
    {
      "src": "api/*.ts",
      "use": "@vercel/node"
    },
    {
      "src": "api/**/*.ts",
      "use": "@vercel/node"
    }
  ],
  "rewrites": [
    {
      "source": "/api/:route*",
      "destination": "/api/[...route]?route=:route*"
    },
    {
      "source": "/api",
      "destination": "/api/index"
    }
  ]
}
